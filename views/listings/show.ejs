<% layout("/layouts/boilerplate") %>

<div class="container py-4">

    <!-- Heading -->
    <div class="row">
        <div class="col-8 offset-2">
            <h3 class="mb-4 fw-bold"><%= listing.title %></h3>
        </div>
    </div>

    <!-- Listing Card -->
    <div class="row">
        <div class="col-lg-6 col-md-8 offset-lg-2 offset-md-2">

            <div class="card shadow-sm border-0">

                <!-- Image -->
                <img 
                    src="<%= listing.image.url %>" 
                    class="card-img-top"
                    alt="listing image"
                    style="height: 350px; object-fit: cover;"
                >

                <!-- Card Body -->
                <div class="card-body p-4">

                    <!-- <h4 class="card-title fw-bold mb-3">
                        <%= listing.title %>
                    </h4> -->

                    <p class="card-text text-muted">
                        <%= listing.description %>
                    </p>

                    <h5 class="fw-bold mt-3">
                       ₹ <%= listing.price ? listing.price.toLocaleString("en-IN") : "Price not available" %>
                    </h5>

                    <p class="text-secondary mt-2 mb-0">
                        <i class="bi bi-geo-alt"></i>
                        <%= listing.location %> |
                        <%= listing.country %>
                    </p>

                </div>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex gap-2 mt-4">

                <a 
                    href="/Listings/<%= listing._id %>/edit"
                    class="btn btn-dark"
                >
                    Edit Listing
                </a>

                <form 
                    method="POST"
                    action="/Listings/<%= listing._id %>?_method=DELETE"
                >
                    <button 
                        type="submit"
                        class="btn btn-danger"
                    >
                        Delete Listing
                    </button>
                </form>

                <a 
                    href="/Listings"
                    class="btn btn-outline-secondary"
                >
                    Back
                </a>

            </div>

        </div>
    </div>

    <div class="col-8 offset-2 mb-3" >

        <hr/>
        <h4> Leave a Review </h4>

        <form action="" >

            <div class="mb-3 mt-3">
                <label for="rating" class="form-label">Rating</label>


                <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range"/>

            </div>

            <div class="mb-3 mt-3">
                <label for="comment" class="form-label">comments</label>
                <textarea name="comment" id="comment" col="30" row="5" class="form-control" ></textarea>
            </div>

            <button class="btn btn-outline-dark ">Submit </button>
        </form>
    </div>

</div>