<% layout("/layouts/boilerplate") %>

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-7 col-md-9">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-4 p-md-5">

                    <!-- Header -->
                    <div class="text-center mb-4">

                        <h1 class="fw-bold mb-2">
                            Edit Listing
                        </h1>

                        <p class="text-muted mb-0">
                            Update the details of your Wanderlust listing.
                        </p>

                    </div>


                    <!-- Form -->
                    <form
                        method="POST"
                        action="/Listings/<%= listing._id %>?_method=PUT"
                        class="needs-validation"
                        novalidate
                    >

                        <!-- Title -->
                        <div class="mb-3">

                            <label
                                for="title"
                                class="form-label fw-semibold"
                            >
                                Title
                            </label>

                            <input
                                type="text"
                                id="title"
                                name="Listings[title]"
                                value="<%= listing.title %>"
                                class="form-control"
                                placeholder="Enter listing title"
                                required
                                minlength="3"
                            >

                            <div class="invalid-feedback">
                                Please enter a title with at least 3 characters.
                            </div>

                            <div class="valid-feedback">
                                Looks good!
                            </div>

                        </div>


                        <!-- Description -->
                        <div class="mb-3">

                            <label
                                for="description"
                                class="form-label fw-semibold"
                            >
                                Description
                            </label>

                            <textarea
                                id="description"
                                name="Listings[description]"
                                class="form-control"
                                rows="5"
                                placeholder="Describe your beautiful destination..."
                                required
                                minlength="10"
                            ><%= listing.description %></textarea>

                            <div class="invalid-feedback">
                                Description must contain at least 10 characters.
                            </div>

                            <div class="valid-feedback">
                                Looks good!
                            </div>

                        </div>


                        <!-- Image URL -->
                        <div class="mb-3">

                            <label
                                for="image"
                                class="form-label fw-semibold"
                            >
                                Image URL
                            </label>

                            <input
                                type="url"
                                id="image"
                                name="Listings[image]"
                                value="<%= listing.image %>"
                                class="form-control"
                                placeholder="https://example.com/image.jpg"
                            >

                            <div class="invalid-feedback">
                                Please enter a valid image URL.
                            </div>

                            <div class="valid-feedback">
                                Valid image URL.
                            </div>

                        </div>


                        <!-- Price + Location -->
                        <div class="row">

                            <!-- Price -->
                            <div class="col-md-6 mb-3">

                                <label
                                    for="price"
                                    class="form-label fw-semibold"
                                >
                                    Price
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        ₹
                                    </span>

                                    <input
                                        type="number"
                                        id="price"
                                        name="Listings[price]"
                                        value="<%= listing.price %>"
                                        class="form-control"
                                        placeholder="Enter price"
                                        min="1"
                                        required
                                    >

                                    <div class="invalid-feedback">
                                        Please enter a valid price greater than 0.
                                    </div>

                                </div>

                            </div>


                            <!-- Location -->
                            <div class="col-md-6 mb-3">

                                <label
                                    for="location"
                                    class="form-label fw-semibold"
                                >
                                    Location
                                </label>

                                <input
                                    type="text"
                                    id="location"
                                    name="Listings[location]"
                                    value="<%= listing.location %>"
                                    class="form-control"
                                    placeholder="Enter location"
                                    required
                                    minlength="2"
                                >

                                <div class="invalid-feedback">
                                    Please enter a valid location.
                                </div>

                            </div>

                        </div>


                        <!-- Country -->
                        <div class="mb-4">

                            <label
                                for="country"
                                class="form-label fw-semibold"
                            >
                                Country
                            </label>

                            <input
                                type="text"
                                id="country"
                                name="Listings[country]"
                                value="<%= listing.country %>"
                                class="form-control"
                                placeholder="Enter country"
                                required
                                minlength="2"
                            >

                            <div class="invalid-feedback">
                                Please enter a valid country.
                            </div>

                        </div>


                        <!-- Update Button -->
                        <div class="d-grid">

                            <button
                                type="submit"
                                class="btn btn-danger btn-lg"
                            >
                                Update Listing
                            </button>

                        </div>


                        <!-- Back -->
                        <div class="text-center mt-3">

                            <a
                                href="/Listings/<%= listing._id %>"
                                class="text-decoration-none text-secondary"
                            >
                                ← Back to listing
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

<script src="/js/script.js"></script>